root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[docs/images/examples/**]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
